generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum GameColor {
  WHITE
  BLACK
}

enum GameStatus {
  WAITING
  ACTIVE
  COMPLETED
  ABANDONED
}

enum MoveResult {
  NORMAL
  CAPTURE
  CHECK
  CHECKMATE
  STALEMATE
  DRAW
}

model Game {
  id             String      @id @default(cuid())
  status         GameStatus  @default(WAITING)
  whitePlayerId  String?
  blackPlayerId  String?
  winnerColor    GameColor?
  startedAt      DateTime?
  endedAt        DateTime?
  lastMoveAt     DateTime?
  initialFen     String      @default("start")
  finalFen       String?
  resultReason   String?

  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  deletedAt      DateTime?

  createdById    String?
  updatedById    String?
  deletedById    String?

  moves          GameMove[]

  @@index([status])
  @@index([whitePlayerId])
  @@index([blackPlayerId])
  @@index([startedAt])
}

model GameMove {
  id             String      @id @default(cuid())
  gameId         String
  moveNumber     Int
  moverId        String?
  color          GameColor
  fromSquare     String
  toSquare       String
  promotion      String?
  san            String?
  uci            String?
  fenBefore      String?
  fenAfter       String?
  result         MoveResult  @default(NORMAL)
  timeSpentMs    Int?

  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  deletedAt      DateTime?

  createdById    String?
  updatedById    String?
  deletedById    String?

  game           Game        @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([gameId, moveNumber])
  @@index([gameId])
  @@index([moverId])
  @@index([createdAt])
}
